generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STAFF
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentLevel {
  MASTER
  DOCTORATE
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FileType {
  PDF
  POWERPOINT
  AUDIO
  VIDEO
  DOCUMENT
  LINK
}

enum NotificationType {
  GENERAL
  CLASS_CANCELLED
  CLASS_POSTPONED
  NEW_FILE
  IMPORTANT
  MOCK_EXAM
  MOCK_EXAM_DATE_CHANGED
  MOCK_EXAM_LINK_AVAILABLE
}

enum NotificationTargetType {
  GLOBAL
  COURSE
  STUDENT
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum OfflineRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MockExamStatus {
  DRAFT
  SCHEDULED
  LINK_AVAILABLE
  LIVE
  COMPLETED
  CANCELLED
}

enum PublicContentType {
  RULES
  EXAM_ANALYSIS
}

enum CounselingSlotStatus {
  AVAILABLE
  BOOKED
  DISABLED
}

enum CounselingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentPurpose {
  COURSE_FEE
  BOOK
  MOCK_EXAM
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

model User {
  id String @id @default(cuid())
  username String @unique
  passwordHash String
  role UserRole
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  sessions Session[]
  student Student?
  auditLogs AuditLog[]
  notifications Notification[] @relation("NotificationCreator")
  reviewedRequests OfflineRequest[] @relation("OfflineRequestReviewer")
  reviewedPayments Payment[] @relation("PaymentReviewer")
  supportMessages SupportMessage[]
  updatedContent GeneralContent[] @relation("GeneralContentUpdater")
  publicContents PublicContent[]
  recordedPayments Payment[] @relation("PaymentRecorder")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Student {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  nationalId String @unique
  phone String?
  academicLevel StudentLevel?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  notificationTargets NotificationTargetStudent[]
  notificationReads NotificationRead[]
  supportTickets SupportTicket[]
  offlineRequests OfflineRequest[]
  mockExamParticipants MockExamParticipant[]
  counselingRequests CounselingRequest[]
  payments Payment[]
}

model Course {
  id String @id @default(cuid())
  title String
  professor String
  level String?
  description String?
  term String?
  category String?
  startDate String?
  schedule String?
  price Decimal? @db.Decimal(12, 2)
  coverImage String?
  coverImageStorageKey String?
  academicYear Int?
  classDays String[] @default([])
  classStartTime String?
  classEndTime String?
  status CourseStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  sessions CourseSession[]
  files CourseFile[]
  notifications Notification[]
  offlineRequests OfflineRequest[]
  payments Payment[]
  mockExams MockExamCourse[]
}

model Enrollment {
  id String @id @default(cuid())
  studentId String
  courseId String
  status EnrollmentStatus @default(ACTIVE)
  tuitionAmount Decimal? @db.Decimal(12, 2)
  enrolledAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

model CourseSession {
  id String @id @default(cuid())
  courseId String
  sessionNumber Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notifications Notification[]
  offlineRequests OfflineRequest[]

  @@unique([courseId, sessionNumber])
  @@index([courseId])
}

model CourseFile {
  id String @id @default(cuid())
  courseId String
  title String
  type FileType
  storageKey String?
  mimeType String?
  fileSize BigInt?
  externalUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Notification {
  id String @id @default(cuid())
  title String
  content String
  type NotificationType
  targetType NotificationTargetType
  createdById String
  courseId String?
  sessionId String?
  createdAt DateTime @default(now())

  createdBy User @relation("NotificationCreator", fields: [createdById], references: [id])
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  students NotificationTargetStudent[]
  reads NotificationRead[]

  @@index([courseId])
  @@index([sessionId])
  @@index([createdAt])
}

model NotificationTargetStudent {
  notificationId String
  studentId String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([notificationId, studentId])
}

model NotificationRead {
  notificationId String
  studentId String
  readAt DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([notificationId, studentId])
}

model SupportTicket {
  id String @id @default(cuid())
  studentId String
  subject String
  status SupportTicketStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([studentId, status])
}

model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  senderUserId String
  content String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderUserId], references: [id])

  @@index([ticketId, createdAt])
}

model OfflineRequest {
  id String @id @default(cuid())
  studentId String
  courseId String
  sessionId String
  status OfflineRequestStatus @default(PENDING)
  meetingLink String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer User? @relation("OfflineRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([studentId, courseId, status])
}

model MockExam {
  id String @id @default(cuid())
  title String
  level String
  field String
  description String?
  examDate DateTime
  examUrl String?
  status MockExamStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MockExamParticipant[]
  courses MockExamCourse[]

  @@index([status, examDate])
  @@index([level, field])
}

model MockExamParticipant {
  mockExamId String
  studentId String
  createdAt DateTime @default(now())

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([mockExamId, studentId])
  @@index([studentId])
}

model MockExamCourse {
  mockExamId String
  courseId String

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([mockExamId, courseId])
  @@index([courseId])
}

model PastExam {
  id String @id @default(cuid())
  title String
  year Int
  level String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codes PastExamCode[]

  @@index([year, level])
}

model PastExamCode {
  id String @id @default(cuid())
  pastExamId String
  field String
  fieldCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pastExam PastExam @relation(fields: [pastExamId], references: [id], onDelete: Cascade)
  questions PastExamQuestion[]

  @@unique([pastExamId, fieldCode])
  @@index([fieldCode])
}

model PastExamQuestion {
  id String @id @default(cuid())
  pastExamCodeId String
  questionNumber Int
  explanation String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pastExamCode PastExamCode @relation(fields: [pastExamCodeId], references: [id], onDelete: Cascade)

  @@unique([pastExamCodeId, questionNumber])
  @@index([pastExamCodeId])
}

model CounselingSlot {
  id String @id @default(cuid())
  startAt DateTime
  status CounselingSlotStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request CounselingRequest?

  @@index([startAt, status])
}

model CounselingRequest {
  id String @id @default(cuid())
  studentId String
  slotId String
  status CounselingRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot CounselingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId])
  @@index([studentId, status])
}

model Book {
  id String @id @default(cuid())
  title String
  description String?
  coverImage String?
  category String?
  price Decimal? @db.Decimal(12, 2)
  discountedPrice Decimal? @db.Decimal(12, 2)
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([isActive, displayOrder])
}

model PublicContent {
  id String @id @default(cuid())
  type PublicContentType
  slug String @unique
  title String
  subtitle String?
  content String @db.Text
  examYear String?
  examLevel String?
  resourceUrl String?
  published Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([type, published, sortOrder])
  @@index([examYear, examLevel])
}

model Payment {
  id String @id @default(cuid())
  studentId String
  courseId String?
  bookId String?
  purpose PaymentPurpose
  amount Decimal @db.Decimal(12, 2)
  paymentDate DateTime
  trackingCode String?
  status PaymentStatus @default(PENDING)
  rejectionReason String?
  method PaymentMethod @default(OTHER)
  reference String?
  note String?
  paidAt DateTime @default(now())
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedAt DateTime?
  reviewedBy String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  reviewer User? @relation("PaymentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdBy User? @relation("PaymentRecorder", fields: [createdById], references: [id], onDelete: SetNull)
  receipts PaymentReceipt[]

  @@index([studentId, status])
  @@index([courseId])
  @@index([bookId])
  @@index([paymentDate])
  @@index([studentId, paidAt])
  @@index([createdById, createdAt])
}

model PaymentReceipt {
  id String @id @default(cuid())
  paymentId String
  storageKey String
  mimeType String
  fileSize BigInt?
  uploadedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, uploadedAt])
}

model GeneralContent {
  id String @id @default(cuid())
  key String @unique
  title String
  content String
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("GeneralContentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Achievement {
  id String @id @default(cuid())
  title String
  studentName String
  year Int
  level String?
  field String?
  university String?
  rank String?
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, year, displayOrder])
}

model AuditLog {
  id String @id @default(cuid())
  actorUserId String
  action String
  entityType String
  entityId String?
  metadata Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
