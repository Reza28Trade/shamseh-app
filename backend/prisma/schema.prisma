generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  STAFF
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FileType {
  PDF
  POWERPOINT
  AUDIO
  VIDEO
  DOCUMENT
  LINK
}

enum NotificationType {
  GENERAL
  CLASS_CANCELLED
  CLASS_POSTPONED
  NEW_FILE
  IMPORTANT
  MOCK_EXAM
  MOCK_EXAM_DATE_CHANGED
  MOCK_EXAM_LINK_AVAILABLE
}

enum NotificationTargetType {
  GLOBAL
  COURSE
  STUDENT
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum OfflineRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MockExamStatus {
  DRAFT
  SCHEDULED
  LINK_AVAILABLE
  LIVE
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  username String @unique
  passwordHash String
  role UserRole
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  sessions Session[]
  student Student?
  auditLogs AuditLog[]
  notifications Notification[] @relation("NotificationCreator")
  reviewedRequests OfflineRequest[] @relation("OfflineRequestReviewer")
  supportMessages SupportMessage[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Student {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  nationalId String @unique
  phone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  notificationTargets NotificationTargetStudent[]
  notificationReads NotificationRead[]
  supportTickets SupportTicket[]
  offlineRequests OfflineRequest[]
}

model Course {
  id String @id @default(cuid())
  title String
  professor String
  level String?
  description String?
  term String?
  category String?
  price Decimal? @db.Decimal(12, 2)
  coverImage String?
  status CourseStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enrollments Enrollment[]
  sessions CourseSession[]
  files CourseFile[]
  notifications Notification[]
  offlineRequests OfflineRequest[]
  mockExams MockExamCourse[]
}

model Enrollment {
  id String @id @default(cuid())
  studentId String
  courseId String
  status EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([studentId, courseId])
  @@index([courseId])
}

model CourseSession {
  id String @id @default(cuid())
  courseId String
  sessionNumber Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notifications Notification[]
  offlineRequests OfflineRequest[]
  @@unique([courseId, sessionNumber])
  @@index([courseId])
}

model CourseFile {
  id String @id @default(cuid())
  courseId String
  title String
  type FileType
  storageKey String?
  mimeType String?
  fileSize BigInt?
  externalUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([courseId])
}

model Notification {
  id String @id @default(cuid())
  title String
  content String
  type NotificationType
  targetType NotificationTargetType
  createdById String
  courseId String?
  sessionId String?
  createdAt DateTime @default(now())
  createdBy User @relation("NotificationCreator", fields: [createdById], references: [id])
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  students NotificationTargetStudent[]
  reads NotificationRead[]
  @@index([courseId])
  @@index([sessionId])
  @@index([createdAt])
}

model NotificationTargetStudent {
  notificationId String
  studentId String
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([notificationId, studentId])
}

model NotificationRead {
  notificationId String
  studentId String
  readAt DateTime @default(now())
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([notificationId, studentId])
}

model SupportTicket {
  id String @id @default(cuid())
  studentId String
  subject String
  status SupportTicketStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
  @@index([studentId, status])
}

model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  senderUserId String
  content String
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderUserId], references: [id])
  @@index([ticketId, createdAt])
}

model OfflineRequest {
  id String @id @default(cuid())
  studentId String
  courseId String
  sessionId String
  status OfflineRequestStatus @default(PENDING)
  meetingLink String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer User? @relation("OfflineRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  @@index([studentId, courseId, status])
}

model MockExam {
  id String @id @default(cuid())
  title String
  level String
  field String
  description String?
  examDate DateTime
  examUrl String?
  status MockExamStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses MockExamCourse[]
  @@index([status, examDate])
  @@index([level, field])
}

model MockExamCourse {
  mockExamId String
  courseId String
  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([mockExamId, courseId])
  @@index([courseId])
}

model AuditLog {
  id String @id @default(cuid())
  actorUserId String
  action String
  entityType String
  entityId String?
  metadata Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorUserId], references: [id])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
